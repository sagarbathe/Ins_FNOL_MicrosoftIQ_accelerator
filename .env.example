# Copy this file to .env in the repo root and fill in the values below.
# .env is git-ignored — your tenant-specific values will never be committed.

# --- Fabric (required — specific to your tenant, no safe default) ---
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=

# --- Fabric (optional — set once created by the scripts, to reuse across runs) ---
FABRIC_ONTOLOGY_ID=
FABRIC_GRAPH_MODEL_ID=
FABRIC_DATA_AGENT_ID=

# --- Fabric (optional — safe defaults provided, override only if you want different names) ---
# FABRIC_LAKEHOUSE_NAME=LH_AutoFNOL
# FABRIC_ONTOLOGY_NAME=AutoFNOL_Ontology
# FABRIC_DATA_AGENT_NAME=DA_AutoFNOL_Ontology

# --- Azure AI Foundry (required — specific to your tenant) ---
# e.g. https://<your-ai-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_PROJECT_ENDPOINT=

# --- Azure AI Foundry (optional — safe defaults provided) ---
# FOUNDRY_MODEL_DEPLOYMENT=gpt-4o
# FOUNDRY_AGENT_NAME=Auto-FNOL-Knowledge-Agent
# FOUNDRY_SEARCH_CONNECTION_NAME=

# --- Azure AI Search (required endpoint — specific to your tenant) ---
# e.g. https://<your-search-service>.search.windows.net
AZURE_SEARCH_ENDPOINT=
# AZURE_SEARCH_INDEX_NAME=auto-fnol-kb-index
# AZURE_SEARCH_ADMIN_KEY=

# --- Azure OpenAI embeddings (required endpoint — specific to your tenant) ---
# e.g. https://<your-aoai-resource>.cognitiveservices.azure.com
AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# --- Local output paths (optional — defaults to datagen/output in the repo) ---
# DATAGEN_OUTPUT_DIR=
