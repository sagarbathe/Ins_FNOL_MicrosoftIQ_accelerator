{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_448f9"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_microsoftcopilotstudio": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedmicrosoftcopilotstudio_d0307"
        },
        "api": {
          "name": "shared_microsoftcopilotstudio"
        }
      },
      "shared_teams": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedteams_77811"
        },
        "api": {
          "name": "shared_teams"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_new_email_arrives_(V3)": {
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {
            "Id::<YOUR_MAILBOX_INBOX_FOLDER_ID>": "Inbox",
            "Id::<YOUR_MAILBOX_TARGET_FOLDER_ID>": "<YOUR_MAILBOX_TARGET_FOLDER_NAME>",
            "operationMetadataId": "09a2ee7e-d42b-47d0-aceb-99e9343d462f"
          },
          "type": "OpenApiConnectionNotification",
          "inputs": {
            "parameters": {
              "folderPath": "Id::<YOUR_MAILBOX_TARGET_FOLDER_ID>"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "OnNewEmailV3",
              "connectionName": "shared_office365"
            }
          }
        }
      },
      "actions": {
        "Initialize_response_json_schema": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "9ed11f17-6af6-4297-986b-03718390b70a"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "response_json_schema",
                "type": "string",
                "value": "{\n    \"response_message\": \"text\",\n    \"is_urgent\": true,\n}"
              }
            ]
          }
        },
        "Execute_Agent_and_wait": {
          "runAfter": {
            "Initialize_response_json_schema": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "10864b63-775a-49ad-b513-e6b848b89a7d"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "Copilot": "crfaa_MicrosoftIQAgent",
              "body/message": "Determine if the Message Content is an urgent notice from a supplier. Specifically determine via impacting verbiage like unexpected, issues, errors, unresponsive, problems, uncertainty, and production impact. If the message is considered urgent, tell the user that the message may be urgent, include some details from the message, and also include a maximum of 3 next-step, constructive prompts for the user based on the content of the message. These prompt options should help the user investiate further using your other tools. If the specific supplier or product is determined, focus the followup prompts directly on that supplier and/or product. Format your response in JSON format only using the following schema: @{variables('response_json_schema')}. Do not wrap in tildas, only return proper JSON format and no other text before or after. Message Content: @{triggerOutputs()?['body/body']}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio",
              "operationId": "ExecuteCopilotAsyncV2",
              "connectionName": "shared_microsoftcopilotstudio"
            }
          }
        },
        "Parse_JSON_of_agent_response": {
          "runAfter": {
            "Execute_Agent_and_wait": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "e83fe678-424c-4ec9-8d30-03895f0761c2"
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@outputs('Execute_Agent_and_wait')?['body/lastResponse']",
            "schema": {
              "type": "object",
              "properties": {
                "response_message": {
                  "type": "string"
                },
                "is_urgent": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "Is_email_urgent": {
          "actions": {
            "Post_message_in_a_chat_or_channel": {
              "metadata": {
                "operationMetadataId": "d5354f63-a29d-41e7-8903-03c8b27b50b2"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "Power Virtual Agents",
                  "location": "powerva",
                  "body/bot": "crfaa_MicrosoftIQAgent",
                  "body/recipient": "@triggerOutputs()?['body/toRecipients']",
                  "body/messageBody": "<p class=\"editor-paragraph\">Hi, I am an agent here to assist you. I have reviewed a recent incoming email. It seems this email may require urgent attention. Please see analysis below:<br><br>From: @{triggerOutputs()?['body/from']}<br><br>Subject: @{triggerOutputs()?['body/subject']}<br><br>@{body('Parse_JSON_of_agent_response')?['response_message']}<br><br><span style=\"font-size: 13px;\">AI-generated content may be incorrect.</span></p>",
                  "body/attribution": true,
                  "body/activeChat": "Send",
                  "body/installedError": "Fail"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              }
            }
          },
          "runAfter": {
            "Parse_JSON_of_agent_response": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Terminate": {
                "metadata": {
                  "operationMetadataId": "15239824-d13d-4f61-9855-fdac6c36162a"
                },
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Succeeded"
                }
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@body('Parse_JSON_of_agent_response')?['is_urgent']",
                  true
                ]
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "7bd633d3-e667-4299-8206-2bf49fa57423"
          },
          "type": "If"
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}